{
  "name": "nordic-emobility-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:products": "node scripts/generate-products.mjs",
    "verify:checkout-products": "node scripts/verify-checkout-products.mjs",
    "test:status": "node --test tests/service-number.test.mjs tests/quiet-hours.test.mjs",
    "test:voice": "node --test tests/voice-simple.test.mjs tests/voicemail-analysis.test.mjs",
    "nemob-os": "node nemob-os/server.mjs",
    "test:nemob-os": "node --test \"nemob-os/test/*.test.mjs\"",
    "knowledge:extract": "node scripts/extract-chatgpt-repair-knowledge.mjs",
    "knowledge:review": "node scripts/build-repair-knowledge-review.mjs",
    "knowledge:import": "node scripts/import-repair-knowledge.mjs",
    "test:knowledge": "node --test tests/chatgpt-repair-extractor.test.mjs nemob-os/test/repair-knowledge.test.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "build": "npm run test:voice && npm run test:status && npm run generate:products && npm run build:dist && echo Static site ready"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@netlify/blobs": "^8.1.0",
    "stripe": "^14.0.0"
  }
}
